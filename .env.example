EMAIL=INPUT_EMAIL_HERE                              # obtain from deye developers portal
PASSWORD=INPUT_PASSWORD_HERE                        # obtain from deye developers portal
APP_ID=INPUT_APP_ID_HERE                            # obtain from deye developers portal
APP_SECRET=INPUT_APP_SECRET_HERE                    # obtain from deye developers portal

DEVICE_SN=INPUT_DEVICE_SN_HERE                      # obtain from deye app
STATION_ID=INPUT_STATION_ID_HERE                    # obtain from deye app

LATITUDE=INPUT_LATITUDE_HERE                        # example: 90.0000
LONGITUDE=INPUT_LONGITUDE_HERE                      # example: 121.0000

DEV_DUCKDB_PATH=INPUT_DEV_DUCKDB_PATH_HERE          # example: luminos.duckdb
PROD_DUCKDB_PATH=INPUT_PROD_DUCKDB_PATH_HERE        # example: md:luminos_prod
MOTHERDUCK_TOKEN=INPUT_MOTHERDUCK_TOKEN_HERE        # MotherDuck JWT (keep separate from path)
ENV=dev                                             # local default; GitHub Actions sets ENV=prod

AIRFLOW_UID=INPUT_AIRFLOW_UID_HERE                  # example: 50000
AIRFLOW_PROJ_DIR=INPUT_AIRFLOW_PROJ_DIR_HERE        # example: /path/to/airflow/project

FERNET_KEY=INPUT_FERNET_KEY_HERE                    # optional

# optional: if want to set airflow web server credentials
_AIRFLOW_WWW_USER_USERNAME=INPUT_AIRFLOW_WWW_USER_USERNAME_HERE  
_AIRFLOW_WWW_USER_PASSWORD=INPUT_AIRFLOW_WWW_USER_PASSWORD_HERE      
